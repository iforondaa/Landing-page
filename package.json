{
  "name": "landing-publicaciones-colaboradores",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing de publicaciones y registro de colaboradores (V1, SDD).",
  "scripts": {
    "start": "npx --yes serve@14 src -l 5173",
    "lint:spec": "spectral lint spec/openapi.yaml --ruleset .spectral.yaml --fail-severity=warn",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "check:schemas": "node scripts/gen-schemas.mjs --check",
    "test": "vitest run",
    "verify": "npm run lint:spec && npm run check:schemas && npm test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@stoplight/spectral-cli": "6.16.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "vitest": "5.0.3"
  }
}
