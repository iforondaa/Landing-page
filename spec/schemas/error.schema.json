{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "title": "Error",
  "description": "Respuesta de error uniforme de la capa de datos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codigo",
    "mensaje"
  ],
  "properties": {
    "codigo": {
      "type": "string",
      "enum": [
        "VALIDACION",
        "NO_AUTORIZADO",
        "NO_ENCONTRADO",
        "ALMACENAMIENTO"
      ],
      "description": "Código de error legible por máquina."
    },
    "mensaje": {
      "type": "string",
      "description": "Mensaje para mostrar al usuario."
    },
    "detalles": {
      "type": "array",
      "description": "Errores por campo (solo para VALIDACION).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campo",
          "mensaje"
        ],
        "properties": {
          "campo": {
            "type": "string",
            "description": "Nombre del campo."
          },
          "mensaje": {
            "type": "string",
            "description": "Descripción del error."
          }
        }
      }
    }
  },
  "examples": [
    {
      "codigo": "VALIDACION",
      "mensaje": "Revisa los campos marcados.",
      "detalles": [
        {
          "campo": "email",
          "mensaje": "Formato de correo no válido."
        }
      ]
    }
  ]
}
